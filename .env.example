# Generate with: openssl rand -base64 32
AUTH_SECRET=

# From https://console.anthropic.com — required for the AI Doctor chatbot.
# Without this, the chatbot shows a clear "not configured" message instead of crashing.
ANTHROPIC_API_KEY=

# Optional. Only needed if you're running the ML prediction service on a
# non-default host/port (see "Optional: ML prediction service" in README.md).
# ML_API_URL=http://localhost:5000
